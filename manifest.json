{
  "manifest_version": 3,
  "name": "Da Done",
  "version": "1.0",
  "description": "Mark URLs as done. Tag links to them on every page.",
  "permissions": ["storage", "contextMenus", "tabs"],
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "Toggle done for this page",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/normalizeUrl.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
